  "observer_command": "python3 -E -s -S -B - <<'PY'\nimport datetime, hashlib, json, pathlib, shutil, subprocess, sys\nroot=pathlib.Path.cwd()\ntools=[]\nfor name in ('python3','git','bash','realpath','rustfmt'):\n    path=pathlib.Path(shutil.which(name)).resolve()\n    result=subprocess.run([str(path),'--version'],capture_output=True,text=True,check=True)\n    tools.append({'name':name,'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'version':result.stdout.splitlines()[0]})\nfiles={}\nfor name,module in sorted(sys.modules.items()):\n    path=getattr(module,'__file__',None)\n    if path and pathlib.Path(path).is_file():\n        p=pathlib.Path(path).resolve()\n        files[str(p)]={'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}\nmapped=[]\nfor line in pathlib.Path('/proc/self/maps').read_text().splitlines():\n    parts=line.split()\n    if len(parts)>=6 and parts[-1].startswith('/'):\n        p=pathlib.Path(parts[-1])\n        if p.is_file():\n            mapped.append({'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()})\nmapped=list({r['path']:r for r in mapped}.values())\nprint(json.dumps({'schema_version':1,'record_type':'toolchain_preflight','marker':'WDQ-READY-TOOLCHAIN-PREFLIGHT',\n'observed_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n'main_ref':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),\n'tools':tools,'python_flags':{'ignore_environment':sys.flags.ignore_environment,'no_user_site':sys.flags.no_user_site,'no_site':sys.flags.no_site,'dont_write_bytecode':sys.flags.dont_write_bytecode},\n'stdin_isatty':sys.stdin.isatty(),'stdout_isatty':sys.stdout.isatty(),\n'observer_python_module_files':sorted(files.values(),key=lambda x:x['path']),\n'observer_mapped_files':sorted(mapped,key=lambda x:x['path']),\n'limitations':['Read-only preflight observer, not the delivery validator/capture process.','Module and mapped-file records describe this observer only, not complete future proof or subprocess dependency closure.','No new environment selection, fixture, build receipt, producer event, independent replay or owner approval is asserted.'],\n'readiness_asserted':False,'acceptance_asserted':False}))\nPY",
