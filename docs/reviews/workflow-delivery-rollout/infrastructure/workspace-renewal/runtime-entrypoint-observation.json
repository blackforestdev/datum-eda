  "command": "python3 -I -S -B -c 'import sys,os,json,uuid,py_compile,subprocess\nfrom pathlib import Path\nruntime=Path.cwd()\nsys.path.insert(0,str(runtime/\"scripts\"))\nfrom test_workflow_delivery_workspace_entrypoints import WorkspaceEntrypointsTest\nfrom workflow_delivery_capture_command import capture_command,save\nfrom workflow_delivery_support_bundle import prepare_bundle\nfrom workflow_delivery_support_store import support_locations\nfrom workflow_delivery_capture_state import git\npin=\"22192085c55ec654eb209deccc0450afd53b2c65\"\nassert git(runtime,\"rev-parse\",\"HEAD\").decode().strip()==pin and not git(runtime,\"status\",\"--porcelain\")\nstore=Path(\"/home/bfadmin/Documents/datum-eda/.git/datum-wdq/proposals/wdq-full-candidate-inspection-20260909/workspace-runtime-entrypoints\")\nstore.mkdir(exist_ok=False)\nt=WorkspaceEntrypointsTest()\nt.setUp()\nresults=[]\ntry:\n prepare_bundle(t.f.root,t.authority)\n locations=support_locations(t.f.root,t.authority)\n t.f.git(\"config\",\"core.hooksPath\",str(locations[\"hooks\"]))\n t.f.git(\"config\",\"datum.workflowDeliveryRunnerPath\",str(locations[\"runner\"]))\n nonce=str(uuid.uuid4())\n t.f.write(\".git/datum-wdq-capture-owner\",(nonce+\"\\n\").encode())\n environment={\"PATH\":os.defpath,\"HOME\":str(store),\"XDG_CONFIG_HOME\":str(store),\"GIT_CONFIG_NOSYSTEM\":\"1\",\"GIT_CONFIG_GLOBAL\":os.devnull,\"LANG\":\"C\"}\n def observe(label,refusal=None):\n  for surface in (\"C\",\"R\",\"S\",\"H\"):\n   output=store/(label+\"-\"+surface)\n   env=dict(environment)\n   if surface==\"H\":\n    command=[str(locations[\"hook\"])]\n    env[\"DATUM_WDQ_OBSERVE_PATH\"]=str(output/\"calls.jsonl\")\n   else:\n    script=runtime/\"scripts\"/(\"project_status.py\" if surface==\"S\" else \"check_workflow_delivery.py\")\n    args=[\"--root\",str(t.f.root)]\n    args+=[\"check\"] if surface==\"S\" else [\"--enforce\",\"--authority-ref\",t.authority,\"--base-ref\",t.authority,\"--environment-path\",\"requested-environment.json\"]+([\"--staged\"] if surface==\"C\" else [\"--candidate-ref\",t.authority])\n    command=[sys.executable,\"-I\",\"-S\",\"-B\",str(runtime/\"scripts/workflow_delivery_observe_python.py\"),\"--script\",str(script),\"--source-root\",str(runtime),\"--output\",str(output/\"calls.jsonl\"),\"--function\",\"main\",\"--function\",\"selector_failures\",\"--\",*args]\n   result=capture_command(t.f.root,output,command,env,fixture_nonce=nonce,case_id=\"WORKSPACE-\"+label,surface=surface,untracked_roots=[\"src\",\"tools\",\".beads\"],timeout=60)\n   text=(output/\"stdout.bin\").read_text()+(output/\"stderr.bin\").read_text()\n   expected_refusal=surface==\"S\" and refusal is not None\n   assert result[\"kind\"]==\"exited\" and (result[\"returncode\"]!=0)==expected_refusal,text\n   assert not result[\"changed_state_fields\"] and not result[\"changed_files\"],result\n   if expected_refusal: assert refusal in text,text\n   results.append({\"case\":label,\"surface\":surface,\"expected_refusal\":expected_refusal,\"invocation_id\":result[\"invocation_id\"],\"returncode\":result[\"returncode\"],\"capture_directory\":output.name})\n   print(json.dumps(results[-1]),flush=True)\n for level in (0,1,2):\n  py_compile.compile(str(t.f.root/\"src/read.py\"),optimize=level,doraise=True)\n  observe(\"verified-cache-\"+str(level))\n owner=t.f.root/\"tools/local.sh\"\n owner_raw=owner.read_bytes()\n unknown=t.f.root/\"src/__pycache__/unknown.py\"\n unknown.write_bytes(b\"unknown = 1\\n\")\n observe(\"unknown-ignored-source\",\"WDQ-COVERAGE\")\n unknown.unlink()\n observe(\"unknown-restored\")\n owner.write_bytes(b\"changed\")\n observe(\"owner-changed\",\"WDQ-COVERAGE\")\n owner.write_bytes(owner_raw)\n observe(\"owner-restored\")\n owner.unlink()\n observe(\"owner-missing\",\"required pinned local file is missing\")\n owner.write_bytes(owner_raw)\n owner.chmod(0o775)\n observe(\"owner-returned\")\n cache=t.cache\n cache_raw=cache.read_bytes()\n cache.write_bytes(b\"forged bytecode\")\n observe(\"cache-forged\",\"WDQ-COVERAGE\")\n cache.write_bytes(cache_raw)\n observe(\"cache-restored\")\n policy=t.f.root/\"specs/workflow_delivery/workspace-inputs.json\"\n policy_raw=policy.read_bytes()\n policy.write_bytes(policy_raw+b\"\\n\")\n observe(\"policy-changed\",\"WDQ-POLICY\")\n policy.write_bytes(policy_raw)\n observe(\"policy-restored\")\n assert len(results)==52\n subprocess.run([\"tar\",\"-cJf\",str(store/\"fixture.tar.xz\"),\"-C\",str(t.f.root),\".\"],check=True)\n save(store/\"renewal-result.json\",{\"candidate\":pin,\"fixture_authority\":t.authority,\"invocations\":results,\"scope\":\"Synthetic workspace runtime cases across staged CLI, candidate CLI, worktree selector and hook; optimization caches coexist. Not all workspace groups, real roadmap or promotion inspection.\",\"compatibility_complete\":False,\"activation_performed\":False})\n assert git(runtime,\"rev-parse\",\"HEAD\").decode().strip()==pin and not git(runtime,\"status\",\"--porcelain\")\nfinally:\n t.doCleanups()\n'",
