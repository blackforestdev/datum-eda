+++ b/crates/gui-app/src/gpu_attribution_schedule.rs
@@ -0,0 +1,92 @@
+//! Pinned A1 ordering and receipt validation, independent of a GPU.
+pub(super) const CONDITIONS: [char; 7] = ['N', 'D', 'M', 'P', 'A', 'B', 'C'];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Id {
+    pub case: usize,
+    pub phase: &'static str,
+    pub block: usize,
+    pub cycle: usize,
+    pub condition: char,
+}
+pub(super) fn schedule(case: usize, correctness: bool) -> Vec<Id> {
+    let mut result = Vec::new();
+    if correctness {
+        for condition in CONDITIONS {
+            result.push(Id {
+                case,
+                phase: "correctness",
+                block: 0,
+                cycle: 0,
+                condition,
+            });
+        }
+    } else {
+        for cycle in 0..4 {
+            for condition in CONDITIONS {
+                result.push(Id {
+                    case,
+                    phase: "warmup",
+                    block: 0,
+                    cycle,
+                    condition,
+                });
+            }
+        }
+        for block in 0..5 {
+            for cycle in 0..8 {
+                let mut order = CONDITIONS;
+                order.rotate_left((8 * block + cycle) % 7);
+                if (block + cycle) % 2 == 1 {
+                    order.reverse();
+                }
+                for condition in order {
+                    result.push(Id {
+                        case,
+                        phase: "measured",
+                        block,
+                        cycle,
+                        condition,
+                    });
+                }
+            }
+        }
+    }
+    result
+}
+pub(super) fn validate(expected: Id, actual: Id, ticks: &[u64]) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        expected == actual,
+        "A1 reordered/mismatched/duplicate sample"
+    );
+    if actual.condition == 'N' {
+        anyhow::ensure!(ticks.is_empty(), "A1 N has queries");
+    } else {
+        anyhow::ensure!(
+            ticks.len() >= 2 && ticks.len() <= 32 && ticks.windows(2).all(|w| w[0] <= w[1]),
+            "A1 missing/reversed queries"
+        );
+    }
+    Ok(())
+}
+#[test]
+fn attribution_offline_negative_controls() {
+    let ids = schedule(0, false);
+    assert_eq!(ids.len(), 308);
+    let d = ids.iter().copied().find(|id| id.condition == 'D').unwrap();
+    assert!(validate(d, d, &[]).is_err());
+    assert!(validate(ids[0], ids[1], &[1, 2]).is_err());
+    assert!(validate(ids[1], ids[0], &[]).is_err());
+    assert!(validate(d, d, &[2, 1]).is_err());
+    assert!(validate(d, d, &[1, 2]).is_ok());
+    let all: Vec<_> = (0..2)
+        .flat_map(|case| {
+            schedule(case, true)
+                .into_iter()
+                .chain(schedule(case, false))
+        })
+        .collect();
+    assert_eq!(all.len() + 16, 646);
+    for (index, id) in all.iter().enumerate() {
+        assert!(!all[..index].contains(id));
+    }
+}
diff --git a/crates/gui-render/src/render/gpu_attribution.rs b/crates/gui-render/src/render/gpu_attribution.rs
new file mode 100644
index 00000000..da586f8b
--- /dev/null
+++ b/crates/gui-render/src/render/gpu_attribution.rs
@@ -0,0 +1,514 @@
+//! Fixed A1 case execution through the shared preparation, upload and painter owners.
+use super::*;
+use crate::capture_resource::{CaptureReadback, CaptureTarget};
+use crate::gpu_surface::PrefixImages;
+use crate::renderer_state::damage::regional::Plan;
+use gpu_measurements::attribution::Timer;
+use std::time::{Duration, Instant};
+#[path = "gpu_attribution_conformance.rs"]
+mod conformance;
+#[path = "gpu_attribution_io.rs"]
+mod io;
+#[path = "gpu_attribution_manifest.rs"]
+mod manifest;
+#[path = "gpu_attribution_setup.rs"]
+mod setup;
+
+const WIDTH: u32 = 1280;
+const HEIGHT: u32 = 800;
+const BYTES: u64 = WIDTH as u64 * HEIGHT as u64 * 4;
+
+pub struct AttributionCase {
+    old: PreparedScene,
+    frozen: PreparedScene,
+    plan: Plan,
+    old_target: CaptureTarget,
+    expected: Vec<u8>,
+    hybrid: Vec<u8>,
+    images: PrefixImages,
+    readback: CaptureReadback,
+    timer: Timer,
+    next: datum_gui_protocol::ScreenPointPx,
+    hover: datum_gui_protocol::HoverTarget,
+    frozen_uploads: Option<Vec<(wgpu::Buffer, u64, Vec<u8>)>>,
+    pub submissions: usize,
+    pub manifest: String,
+    pub setup_receipt: String,
+}
+#[derive(Debug)]
+pub struct AttributionObservation {
+    pub submission: wgpu::SubmissionIndex,
+    pub phases_ms: Vec<(&'static str, f64)>,
+    pub ticks: Vec<u64>,
+    pub period_ns: f64,
+    pub upload_bytes: usize,
+    pub image_hash: u64,
+    pub gpu_bytes: u64,
+    pub tiles: Vec<[u32; 7]>,
+}
+fn elapsed(start: Instant) -> f64 {
+    start.elapsed().as_secs_f64() * 1000.0
+}
+fn wait(device: &wgpu::Device) -> anyhow::Result<()> {
+    device.poll(wgpu::PollType::Wait {
+        submission_index: None,
+        timeout: Some(Duration::from_secs(2)),
+    })?;
+    Ok(())
+}
+fn submit(
+    queue: &wgpu::Queue,
+    commands: impl IntoIterator<Item = wgpu::CommandBuffer>,
+    count: &mut usize,
+) -> anyhow::Result<wgpu::SubmissionIndex> {
+    anyhow::ensure!(*count < 2200, "A1 submission capacity");
+    let receipt = queue.submit(commands);
+    *count += 1;
+    Ok(receipt)
+}
+fn extent() -> wgpu::Extent3d {
+    wgpu::Extent3d {
+        width: WIDTH,
+        height: HEIGHT,
+        depth_or_array_layers: 1,
+    }
+}
+impl Renderer {
+    pub fn attribution_case(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        state: &datum_gui_protocol::ReviewWorkspaceState,
+        case: usize,
+        mut submissions: usize,
+    ) -> anyhow::Result<AttributionCase> {
+        use datum_gui_protocol::{CrosshairStyle, HoverTarget, PaneContent, ScreenPointPx};
+        let (old, next, id) = match case {
+            0 => (
+                [499.0, 150.0],
+                [500.0, 150.0],
+                "zone:bddd9739-252d-5af8-baf9-eec0be6b999d",
+            ),
+            1 => (
+                [700.0, 269.0],
+                [700.0, 270.0],
+                "zone:b3b2418a-f7a4-5848-aa64-eace29e3cb3a",
+            ),
+            _ => anyhow::bail!("invalid A1 case"),
+        };
+        let hover = HoverTarget {
+            surface: PaneContent::Board,
+            object_id: id.into(),
+        };
+        let mut state = state.clone();
+        state.ui.layout = datum_gui_protocol::WorkspaceLayout::single();
+        state.ui.focus =
+            datum_gui_protocol::ApplicationFocus::Editor(datum_gui_protocol::PaneId(0));
+        // Reproduce archived native closed-dock chrome, not the loader fallback.
+        state.ui.terminal.tabs = vec![datum_gui_protocol::TerminalTabState {
+            session_id: "a1-archived-shell1".into(),
+            previous_session_id: None,
+            label: "shell 1".into(),
+            event_log_path: String::new(),
+            activity_event_count: 0,
+            activity_summary: Vec::new(),
+            active: true,
+            attached: true,
+            status: "running".into(),
+            restart_count: 0,
+            unread_output: false,
+            unread_bell_count: 0,
+        }];
+        state.selection = datum_gui_protocol::SelectionTarget::None;
+        state.ui.hovered_object = Some(hover.clone());
+        state.ui.cursor_pos = Some(ScreenPointPx {
+            x: old[0],
+            y: old[1],
+        });
+        state.ui.crosshair_style = CrosshairStyle::FullViewport;
+        let source = crate::render_input::SourceEpoch::default();
+        self.prepare_session_workspace(
+            &state,
+            crate::WorkspaceView {
+                source_revision: Some(source.revision()),
+                width: WIDTH,
+                height: HEIGHT,
+                scale: 1.0,
+                camera: CameraState {
+                    center_x_nm: 151634208.0,
+                    center_y_nm: 95122896.0,
+                    zoom: 1.0,
+                },
+                schematic_camera: None,
+                include_preferences_overlay: false,
+                single_terminal_snapshot: true,
+                pane_cameras: &[],
+            },
+            &[],
+        )?;
+        let old_target = CaptureTarget::new(device, extent(), self.msaa_format)?;
+        loop {
+            anyhow::ensure!(submissions < 2200, "A1 setup capacity");
+            let plan = self
+                .render_session
+                .prepare_frame(1, 1, 1, true, WIDTH, HEIGHT)?;
+            let frame = self.encode_frame(
+                plan,
+                device,
+                queue,
+                &mut submissions,
+                &mut |_| {
+                    Ok(Some(crate::render_input::FrameTarget::full_texture(
+                        &old_target,
+                    )?))
+                },
+                &mut |count, _| {
+                    *count += 1;
+                },
+            )?;
+            wait(device)?;
+            if let Some(frame) = frame {
+                anyhow::ensure!(
+                    self.render_session.complete_submitted(frame, 1, 1, 1, true),
+                    "A1 initial completion"
+                );
+                break;
+            }
+        }
+        let old = self.render_session.prepared().unwrap().clone();
+        let next = ScreenPointPx {
+            x: next[0],
+            y: next[1],
+        };
+        let session = &mut self.render_session;
+        anyhow::ensure!(
+            session.update_pointer(crate::render_input::PointerUpdate {
+                generation: session.pointer_generation(),
+                cursor: Some(next),
+                hover: Some(&hover),
+                style: CrosshairStyle::FullViewport,
+            }),
+            "A1 source/hover changes cannot use warm pointer path"
+        );
+        anyhow::ensure!(session.interaction_only_damage(), "A1 strong invalidation");
+        let plan = session.regional_plan_for_proof(&old, [WIDTH, HEIGHT]);
+        anyhow::ensure!(!plan.is_empty(), "A1 empty pointer plan");
+        let frozen = session.prepared().unwrap().clone();
+        let setup_receipt = setup::receipt(self, &state, &old, &frozen, case, &hover)?;
+        let images = self
+            .surface_attachments
+            .prefix_images(device)
+            .ok_or_else(|| anyhow::anyhow!("A1 prefix images refused"))?;
+        let readback = CaptureReadback::new(device, BYTES)?;
+        let reference = CaptureTarget::new(device, extent(), self.msaa_format)?;
+        // Full reference uses a separate working attachment; it must not discard retained images.
+        let candidate = std::mem::take(&mut self.surface_attachments);
+        let prefix = std::mem::take(&mut self.render_session.prefix);
+        let board = self.render_session.board().unwrap().clone();
+        let schematic = self.render_session.schematic().cloned();
+        let view = reference.create_view(&Default::default());
+        let reference_result = self.render_with_submission(
+            device,
+            queue,
+            &view,
+            &frozen,
+            &board,
+            schematic.as_ref(),
+            WIDTH,
+            HEIGHT,
+            &mut |_| {
+                submissions += 1;
+            },
+        );
+        self.surface_attachments = candidate;
+        self.render_session.prefix = prefix;
+        anyhow::ensure!(
+            reference_result?,
+            "A1 reference unexpectedly needs cold uploads"
+        );
+        wait(device)?;
+        let (expected, _) = io::read(device, queue, &reference, &readback, &mut submissions)?;
+        let mut result = AttributionCase {
+            old,
+            frozen,
+            plan,
+            old_target,
+            expected,
+            hybrid: Vec::new(),
+            images,
+            readback,
+            timer: Timer::new(device, queue)?,
+            next,
+            hover,
+            frozen_uploads: None,
+            submissions,
+            manifest: String::new(),
+            setup_receipt,
+        };
+        result.manifest = self.attribution_graph_manifest(&result.frozen, &result.plan)?;
+        result.reset(self, device, queue)?;
+        let mut encoder = device.create_command_encoder(&Default::default());
+        result.images.compose_tiles(&mut encoder, &result.plan);
+        submit(queue, [encoder.finish()], &mut result.submissions)?;
+        wait(device)?;
+        // The ablation oracle is old composition with whole selected prefix tiles.
+        result.hybrid = io::read_composed(
+            device,
+            queue,
+            &result.images,
+            &result.readback,
+            &mut result.submissions,
+        )?;
+        Ok(result)
+    }
+}
+impl AttributionCase {
+    pub fn save_reference(&self, path: &std::path::Path) -> anyhow::Result<()> {
+        io::save_image(path, &self.expected)
+    }
+
+    pub fn save_setup_old(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        path: &std::path::Path,
+    ) -> anyhow::Result<()> {
+        let (bytes, _) = io::read(
+            device,
+            queue,
+            &self.old_target,
+            &self.readback,
+            &mut self.submissions,
+        )?;
+        io::save_image(path, &bytes)
+    }
+
+    fn reset(
+        &mut self,
+        renderer: &mut Renderer,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+    ) -> anyhow::Result<()> {
+        let mut encoder = device.create_command_encoder(&Default::default());
+        self.images
+            .reset_composition(&mut encoder, &self.old_target);
+        renderer.encode_regional_composition(
+            device,
+            &mut encoder,
+            &self.frozen,
+            WIDTH,
+            HEIGHT,
+            &self.images,
+            &self.plan,
+            &mut None,
+            composition::RegionalControl {
+                omit: 1,
+                initialize: true,
+            },
+            #[cfg(all(test, feature = "visual"))]
+            crate::gpu_surface::prefix_negative_control::Fault::None,
+        )?;
+        let mut uploads = renderer.flush_frame_uploads(device, queue)?;
+        submit(
+            queue,
+            uploads
+                .as_mut()
+                .map(|b| b.command())
+                .into_iter()
+                .chain([encoder.finish()]),
+            &mut self.submissions,
+        )?;
+        if let Some(batch) = uploads {
+            batch.hold(queue);
+        }
+        renderer.hold_frame_submission(queue, Some(&self.images));
+        self.old_target.hold_submission(queue);
+        wait(device)
+    }
+    pub fn observe(
+        &mut self,
+        renderer: &mut Renderer,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        target: &wgpu::Texture,
+        condition: char,
+    ) -> anyhow::Result<AttributionObservation> {
+        anyhow::ensure!(
+            matches!(condition, 'N' | 'D' | 'M' | 'P' | 'A' | 'B' | 'C'),
+            "A1 unknown condition"
+        );
+        let mut phases = Vec::with_capacity(8);
+        let started = Instant::now();
+        let (prepared, plan) = if condition == 'P' {
+            (self.frozen.clone(), self.plan.clone())
+        } else {
+            let session = renderer.render_session_mut();
+            let accepted = session.update_pointer(crate::render_input::PointerUpdate {
+                generation: session.pointer_generation(),
+                cursor: Some(self.next),
+                hover: Some(&self.hover),
+                style: datum_gui_protocol::CrosshairStyle::FullViewport,
+            });
+            anyhow::ensure!(accepted, "A1 pointer preparation refused");
+            (
+                session.prepared().unwrap().clone(),
+                session.regional_plan_for_proof(&self.old, [WIDTH, HEIGHT]),
+            )
+        };
+        phases.push(("preparation", elapsed(started)));
+        anyhow::ensure!(prepared == self.frozen, "A1 D/P prepared payload differs");
+        anyhow::ensure!(
+            plan.tiles().eq(self.plan.tiles()),
+            "A1 D/P ordered tile plan differs"
+        );
+        let board = renderer.render_session.board().unwrap().clone();
+        let schematic = renderer.render_session.schematic().cloned();
+        let started = Instant::now();
+        let mut upload_submissions = 0;
+        let mut acquired = false;
+        renderer.render_with_acquisition(
+            device,
+            queue,
+            &prepared,
+            &board,
+            schematic.as_ref(),
+            WIDTH,
+            HEIGHT,
+            &mut (),
+            &mut |_| {
+                acquired = true;
+                Ok(None::<crate::render_input::FrameTarget>)
+            },
+            &mut |_, _| {
+                upload_submissions += 1;
+            },
+        )?;
+        self.submissions += upload_submissions;
+        anyhow::ensure!(
+            acquired && upload_submissions == 0,
+            "A1 unexpected cold/upload continuation"
+        );
+        let uploads = renderer.attribution_upload_manifest();
+        let upload_bytes = uploads.iter().map(|(_, _, b)| b.len()).sum();
+        phases.push(("upload_api", elapsed(started)));
+        anyhow::ensure!(
+            renderer.attribution_graph_manifest(&prepared, &plan)? == self.manifest,
+            "A1 D/P commands/bindings changed"
+        );
+        if matches!(condition, 'D' | 'P') {
+            if let Some(previous) = &self.frozen_uploads {
+                anyhow::ensure!(
+                    &uploads == previous,
+                    "A1 D/P upload bytes/resources/offsets/order differ"
+                );
+            } else {
+                self.frozen_uploads = Some(uploads);
+            }
+        }
+        let started = Instant::now();
+        self.reset(renderer, device, queue)?;
+        phases.push(("reset", elapsed(started)));
+        let started = Instant::now();
+        let mut encoder = device.create_command_encoder(&Default::default());
+        self.timer.frame = None;
+        if condition != 'N' {
+            self.timer.start(&mut encoder, condition == 'M');
+        }
+        if condition == 'M' {
+            self.timer.marker(&mut encoder, "upload-leading")?;
+        }
+        renderer.encode_regional_composition(
+            device,
+            &mut encoder,
+            &prepared,
+            WIDTH,
+            HEIGHT,
+            &self.images,
+            &plan,
+            &mut self.timer.frame,
+            composition::RegionalControl {
+                omit: match condition {
+                    'A' => 1,
+                    'B' => 2,
+                    'C' => 3,
+                    _ => 0,
+                },
+                initialize: false,
+            },
+            #[cfg(all(test, feature = "visual"))]
+            crate::gpu_surface::prefix_negative_control::Fault::None,
+        )?;
+        self.images.present(&mut encoder, target);
+        if condition == 'M' {
+            self.timer.marker(&mut encoder, "frame-trailing")?;
+        }
+        if condition != 'N' {
+            self.timer.end(&mut encoder)?;
+        }
+        if condition != 'N' {
+            self.timer.resolve(&mut encoder);
+        }
+        phases.push(("encoding", elapsed(started)));
+        let started = Instant::now();
+        submit(queue, [encoder.finish()], &mut self.submissions)?;
+        renderer.hold_frame_submission(queue, Some(&self.images));
+        phases.push(("submit", elapsed(started)));
+        wait(device)?;
+        phases.push(("completion", elapsed(started)));
+        let started = Instant::now();
+        let ticks = if condition == 'N' {
+            Vec::new()
+        } else {
+            self.timer.read(device)?
+        };
+        phases.push(("query_readback", elapsed(started)));
+        let started = Instant::now();
+        let (bytes, submission) =
+            io::read(device, queue, target, &self.readback, &mut self.submissions)?;
+        phases.push(("image_readback", elapsed(started)));
+        let expected = if matches!(condition, 'A' | 'B' | 'C') {
+            &self.hybrid
+        } else {
+            &self.expected
+        };
+        if &bytes != expected {
+            let root = std::env::var_os("DATUM_A1_ARTIFACT_DIR")
+                .ok_or_else(|| anyhow::anyhow!("missing A1 failure artifact directory"))?;
+            io::save_image(
+                &std::path::Path::new(&root).join("first-failure.png"),
+                &bytes,
+            )?;
+            io::save_image(
+                &std::path::Path::new(&root).join("first-failure-expected.png"),
+                expected,
+            )?;
+            anyhow::bail!("A1 exact acquired-target mismatch in {condition}");
+        }
+        let gpu_bytes = Renderer::gpu_process_reserved_bytes();
+        anyhow::ensure!(gpu_bytes <= 512 * 1024 * 1024, "A1 tracked GPU cap");
+        Ok(AttributionObservation {
+            submission,
+            phases_ms: phases,
+            ticks,
+            period_ns: self.timer.period,
+            upload_bytes,
+            image_hash: io::hash(&bytes),
+            gpu_bytes,
+            tiles: self
+                .plan
+                .tiles()
+                .map(|t| {
+                    [
+                        t.id,
+                        t.source[0],
+                        t.source[1],
+                        t.atlas[0],
+                        t.atlas[1],
+                        t.extent[0],
+                        t.extent[1],
+                    ]
+                })
+                .collect(),
+        })
+    }
+}
diff --git a/crates/gui-render/src/render/gpu_attribution_conformance.rs b/crates/gui-render/src/render/gpu_attribution_conformance.rs
new file mode 100644
index 00000000..60043cbf
--- /dev/null
+++ b/crates/gui-render/src/render/gpu_attribution_conformance.rs
@@ -0,0 +1,174 @@
+//! The fixed sixteen A1 clock/operation observations, no alternate timing method.
+use super::*;
+use crate::text_gpu::budget::GpuReservation;
+use crate::text_gpu::lifetime::{Kind, Owner};
+use wgpu::util::DeviceExt;
+impl Renderer {
+    pub fn attribution_conformance(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        mut emit: impl FnMut(usize, usize, Vec<u64>, f64) -> anyhow::Result<()>,
+    ) -> anyhow::Result<usize> {
+        let owner = Owner::new();
+        let mut submissions = 0;
+        let mut timer = Timer::new(device, queue)?;
+        let size = 4 * 1024 * 1024;
+        let source_charge = GpuReservation::new(size, vec![])?;
+        let source = owner.track_reserved(
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("a1-known-copy-source"),
+                size,
+                usage: wgpu::BufferUsages::COPY_SRC,
+                mapped_at_creation: true,
+            }),
+            1,
+            Kind::Readback,
+            source_charge,
+        );
+        source.slice(..).get_mapped_range_mut().fill(0x5a);
+        source.unmap();
+        let middle_charge = GpuReservation::new(size, vec![])?;
+        let middle = owner.track_reserved(
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("a1-known-copy-middle"),
+                size,
+                usage: wgpu::BufferUsages::COPY_SRC | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }),
+            1,
+            Kind::Readback,
+            middle_charge,
+        );
+        let buffer = CaptureReadback::new(device, size)?;
+        let target = CaptureTarget::new(device, extent(), self.msaa_format)?;
+        let working = self.ensure_msaa(device, WIDTH, HEIGHT)?.clone();
+        self.uniform_buffer.sync(
+            queue,
+            ScreenUniform {
+                resolution: [WIDTH as f32, HEIGHT as f32],
+                _pad: [0.0; 2],
+            },
+        );
+        let mut upload = self.flush_frame_uploads(device, queue)?;
+        if let Some(batch) = &mut upload {
+            submit(queue, [batch.command()], &mut submissions)?;
+        }
+        if let Some(batch) = upload {
+            batch.hold(queue);
+        }
+        wait(device)?;
+        let mut vertices: Vec<Vertex> = [
+            [0.0, 0.0],
+            [1280.0, 0.0],
+            [0.0, 800.0],
+            [0.0, 800.0],
+            [1280.0, 0.0],
+            [1280.0, 800.0],
+        ]
+        .into_iter()
+        .map(|position| Vertex {
+            pos: position,
+            color: [1.0, 0.0, 0.0],
+        })
+        .collect();
+        vertices.extend(vertices.clone().into_iter().map(|mut v| {
+            v.color = [0.0, 0.0, 1.0];
+            v
+        }));
+        let reservation =
+            GpuReservation::new(std::mem::size_of_val(vertices.as_slice()) as u64, vec![])?;
+        let quad = owner.track_reserved(
+            device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("a1-known-quad"),
+                contents: bytemuck::cast_slice(&vertices),
+                usage: wgpu::BufferUsages::VERTEX,
+            }),
+            1,
+            Kind::Readback,
+            reservation,
+        );
+        for repeat in 0..2 {
+            for case in 0..8 {
+                let mut encoder = device.create_command_encoder(&Default::default());
+                if case != 7 {
+                    timer.start(&mut encoder, case == 6);
+                }
+                match case {
+                    0 => (),
+                    1 | 4 | 5 => {
+                        for pass_index in 0..if case == 5 { 2 } else { 1 } {
+                            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                                    view: &working,
+                                    resolve_target: Some(&target.create_view(&Default::default())),
+                                    depth_slice: None,
+                                    ops: wgpu::Operations {
+                                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                                        store: wgpu::StoreOp::Store,
+                                    },
+                                })],
+                                ..Default::default()
+                            });
+                            if case != 1 {
+                                pass.set_pipeline(&self.pipeline);
+                                pass.set_bind_group(0, &self.uniform_bind_group, &[]);
+                                pass.set_bind_group(1, &self.damage_masks.unrestricted.group, &[]);
+                                pass.set_vertex_buffer(0, quad.slice(..));
+                                pass.draw(pass_index * 6..pass_index * 6 + 6, 0..1);
+                            }
+                        }
+                    }
+                    2 | 7 => encoder.copy_buffer_to_buffer(&source, 0, &buffer, 0, size),
+                    3 => {
+                        encoder.copy_buffer_to_buffer(&source, 0, &middle, 0, size);
+                        encoder.copy_buffer_to_buffer(&middle, 0, &buffer, 0, size);
+                    }
+                    6 => timer.marker(&mut encoder, "a1-production-marker")?,
+                    _ => unreachable!(),
+                }
+                if case != 7 {
+                    timer.end(&mut encoder)?;
+                    timer.resolve(&mut encoder);
+                }
+                submit(queue, [encoder.finish()], &mut submissions)?;
+                wait(device)?;
+                let ticks = if case == 7 {
+                    Vec::new()
+                } else {
+                    timer.read(device)?
+                };
+                if matches!(case, 2 | 3 | 7) {
+                    let slice = buffer.slice(..);
+                    let (tx, rx) = std::sync::mpsc::channel();
+                    slice.map_async(wgpu::MapMode::Read, move |r| {
+                        let _ = tx.send(r);
+                    });
+                    wait(device)?;
+                    rx.recv_timeout(Duration::from_secs(2))??;
+                    anyhow::ensure!(
+                        slice.get_mapped_range().iter().all(|b| *b == 0x5a),
+                        "A1 conformance copy bytes"
+                    );
+                    buffer.unmap();
+                }
+                if matches!(case, 1 | 4 | 5) {
+                    let (bytes, _) = io::read(device, queue, &target, &buffer, &mut submissions)?;
+                    let expected = if case == 1 {
+                        [0, 0, 0, 255]
+                    } else if case == 5 {
+                        [255, 0, 0, 255]
+                    } else {
+                        [0, 0, 255, 255]
+                    };
+                    anyhow::ensure!(
+                        bytes.chunks_exact(4).all(|p| p == expected),
+                        "A1 exact8 conformance pixels"
+                    );
+                }
+                emit(repeat, case, ticks, timer.period)?;
+            }
+        }
+        Ok(submissions)
+    }
+}
diff --git a/crates/gui-render/src/render/gpu_attribution_io.rs b/crates/gui-render/src/render/gpu_attribution_io.rs
new file mode 100644
index 00000000..d34bd1fa
--- /dev/null
+++ b/crates/gui-render/src/render/gpu_attribution_io.rs
@@ -0,0 +1,71 @@
+//! Bounded exact raw-byte readback, outside the attributed graph interval.
+use super::*;
+pub(super) fn read(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    texture: &wgpu::Texture,
+    buffer: &CaptureReadback,
+    submissions: &mut usize,
+) -> anyhow::Result<(Vec<u8>, wgpu::SubmissionIndex)> {
+    anyhow::ensure!(
+        texture.usage().contains(wgpu::TextureUsages::COPY_SRC),
+        "A1 target lacks COPY_SRC"
+    );
+    let mut encoder = device.create_command_encoder(&Default::default());
+    encoder.copy_texture_to_buffer(
+        texture.as_image_copy(),
+        wgpu::TexelCopyBufferInfo {
+            buffer,
+            layout: wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(WIDTH * 4),
+                rows_per_image: Some(HEIGHT),
+            },
+        },
+        extent(),
+    );
+    let submission = submit(queue, [encoder.finish()], submissions)?;
+    buffer.hold_submission(queue);
+    let slice = buffer.slice(..BYTES);
+    let (tx, rx) = std::sync::mpsc::channel();
+    slice.map_async(wgpu::MapMode::Read, move |r| {
+        let _ = tx.send(r);
+    });
+    wait(device)?;
+    rx.recv_timeout(Duration::from_secs(2))??;
+    let bytes = slice.get_mapped_range().to_vec();
+    buffer.unmap();
+    Ok((bytes, submission))
+}
+pub(super) fn read_composed(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    images: &PrefixImages,
+    buffer: &CaptureReadback,
+    submissions: &mut usize,
+) -> anyhow::Result<Vec<u8>> {
+    Ok(read(
+        device,
+        queue,
+        images.composed_texture(),
+        buffer,
+        submissions,
+    )?
+    .0)
+}
+pub(super) fn hash(bytes: &[u8]) -> u64 {
+    bytes.iter().fold(0xcbf29ce484222325, |h, b| {
+        (h ^ u64::from(*b)).wrapping_mul(0x100000001b3)
+    })
+}
+
+pub(super) fn save_image(path: &std::path::Path, bytes: &[u8]) -> anyhow::Result<()> {
+    let mut rgba = bytes.to_vec();
+    for pixel in rgba.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
+    }
+    image::RgbaImage::from_raw(WIDTH, HEIGHT, rgba)
+        .ok_or_else(|| anyhow::anyhow!("A1 reference image extent"))?
+        .save(path)?;
+    Ok(())
+}
diff --git a/crates/gui-render/src/render/gpu_attribution_manifest.rs b/crates/gui-render/src/render/gpu_attribution_manifest.rs
