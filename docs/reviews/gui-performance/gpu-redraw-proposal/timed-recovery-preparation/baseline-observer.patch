+//! Measurement-only baseline bridge. No scheduling, cache or presentation authority.
+#[path = "baseline_frame_workload.rs"]
+mod causal;
+pub(crate) struct Lineage {
+    revision: u64,
+    preparation: u64,
+    attempt: u64,
+    acknowledged: u64,
+    workload: causal::Workload,
+}
+impl Lineage {
+    pub(crate) fn content_revision(&self) -> u64 {
+        self.revision
+    }
+    pub(crate) fn measurement_activity(&self) -> [u64; 2] {
+        [self.revision, self.attempt]
+    }
+    pub(crate) fn set_measurement_workload(&mut self, value: [u64; 3]) -> anyhow::Result<()> {
+        self.workload.context(value)
+    }
+    pub(crate) fn end_measurement_workload(&mut self, retain: bool) {
+        self.workload.end_context(retain);
+    }
+    pub(crate) fn changed(&mut self) {
+        self.revision = self
+            .revision
+            .checked_add(1)
+            .expect("baseline revision overflow");
+        self.workload.changed(self.revision);
+    }
+    pub(crate) fn prepared(&mut self) {
+        self.preparation = self
+            .preparation
+            .checked_add(1)
+            .expect("baseline preparation overflow");
+    }
+    pub(crate) fn begin(&mut self, owner: u64, target: [u64; 3]) -> ([u64; 7], [u64; 8]) {
+        self.attempt = self
+            .attempt
+            .checked_add(1)
+            .expect("baseline attempt overflow");
+        (
+            [
+                owner,
+                self.attempt,
+                self.revision,
+                self.preparation,
+                target[0],
+                target[1],
+                target[2],
+            ],
+            self.workload.pending(self.acknowledged),
+        )
+    }
+    pub(crate) fn presented(&mut self) {
+        self.acknowledged = self.revision;
+    }
+}
+
+impl Default for Lineage {
+    fn default() -> Self {
+        Self {
+            revision: 1,
+            preparation: 0,
+            attempt: 0,
+            acknowledged: 0,
+            workload: Default::default(),
+        }
+    }
+}
