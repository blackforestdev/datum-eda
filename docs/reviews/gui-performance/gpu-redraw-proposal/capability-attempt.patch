+    #[cfg(all(feature = "visual", target_os = "linux"))]
+    #[test]
+    #[ignore = "bounded PM048 actual-adapter capability gate"]
+    fn prefix_pair_actual_eight_sample_copy_capability() {
+        let instance = wgpu::Instance::new(&wgpu::InstanceDescriptor {
+            backends: wgpu::Backends::VULKAN,
+            ..Default::default()
+        });
+        let adapter =
+            pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions::default()))
+                .unwrap();
+        eprintln!("PM048 adapter: {:?}", adapter.get_info());
+        assert!(
+            adapter.get_info().name.contains("P630"),
+            "requires pinned Intel P630"
+        );
+        let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+            required_features: wgpu::Features::TEXTURE_ADAPTER_SPECIFIC_FORMAT_FEATURES,
+            ..Default::default()
+        }))
+        .unwrap();
+        let mut owner = SurfaceAttachments::default();
+        owner.request_prefix();
+        let key = AttachmentKey::new(32, 32, wgpu::TextureFormat::Bgra8UnormSrgb, 8);
+        device.push_error_scope(wgpu::ErrorFilter::Validation);
+        owner.ensure(&device, key).unwrap();
+        let (a, b, a_view, _) = owner.prefix_images().expect("admitted prefix pair");
+        assert_eq!(owner.generations.used(), 1);
+        let records = owner.owner.records();
+        assert_eq!(records.len(), 2);
+        assert_eq!(
+            records.iter().map(|r| r.bytes).sum::<u64>(),
+            32 * 32 * 4 * 8 * 2
+        );
+        let mut encoder = device.create_command_encoder(&Default::default());
+        {
+            let _pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("prefix-capability-clear"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &a_view,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::RED),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                ..Default::default()
+            });
+        }
+        encoder.copy_texture_to_texture(a.as_image_copy(), b.as_image_copy(), a.size());
+        let submission = queue.submit([encoder.finish()]);
+        let holds: Vec<_> = owner.submission_ref().collect();
+        crate::text_gpu::hold_until_done(&queue, holds);
+        device
+            .poll(wgpu::PollType::Wait {
+                submission_index: Some(submission),
+                timeout: None,
+            })
+            .unwrap();
+        assert!(
+            pollster::block_on(device.pop_error_scope()).is_none(),
+            "actual 8x copy validation"
+        );
+    }
